# dependencies
node_modules/
/.pnp
.pnp.*

# build output
/.next/
/out/
dist/
build/

# testing
coverage/

# env files (never commit secrets; .env.example is safe to commit)
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.key
.vercel

# editors and personal tool settings
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/settings.local.json

# prettier settings stay local
.prettierrc*
.prettierignore

# markdown docs stay local; only the README is published
*.md
!/README.md

# local data and scratch files (real contact exports, database dumps, temp scripts)
*.csv
!samples/*.csv
# route folders such as src/app/api/lists/[id]/links.csv/ are code, not data
!/src/app/**/*.csv
dump/
backups/
tmp/
scripts/.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts
