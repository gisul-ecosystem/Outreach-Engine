# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Next.js reads .env.local automatically; the worker and scripts load the same file.

# MongoDB connection string (MongoDB Community Server installed on this computer, default port 27017)
MONGODB_URI=mongodb://localhost:27017/outreach

# Public address of the app
APP_URL=http://localhost:3000

# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 32-byte key (base64) that encrypts provider secrets in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: if you change or lose this key, saved provider secrets can no longer be decrypted.
ENCRYPTION_KEY=

# Timezone used for sending windows, "today" and display
APP_TIMEZONE=Asia/Kolkata

# true = use the FakeProvider, NO real email is sent
DRY_RUN=true

# Global kill switch for the worker. Real sending needs DRY_RUN=false AND SENDING_ENABLED=true
SENDING_ENABLED=false

# First admin user, created by `npm run seed` (Phase 1). Password: at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Read each inbox's Sent Items + replies to hand-sent emails (read-only, works in DRY_RUN). Default true.
MAILBOX_READING=true

# ---- Click tracking (Phase 10) ----
# Start of every tracking link. Locally http://localhost:3000; once online e.g. https://go.racko.ai
TRACKING_BASE_URL=http://localhost:3000
# The only sites a tracking link may lead to (comma-separated)
TRACKING_ALLOWED_HOSTS=racko.ai,www.racko.ai
# Where unknown links (and any error) go. Must be https and in TRACKING_ALLOWED_HOSTS
TRACKING_FALLBACK_URL=https://racko.ai
# Secret that scrambles visitor IP addresses (raw IPs are never stored). At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRACKING_IP_SECRET=
# true ONLY when the engine runs behind Nginx or Cloudflare (then the visitor IP comes from their headers)
TRUST_PROXY=false
