# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Next.js reads .env.local automatically; the worker and scripts load the same file.

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection string
# - Local development: mongodb://localhost:27017/outreach (MongoDB Community Server)
# - Docker: mongodb://mongo:27017/outreach (automatically set in docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/outreach

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Public URL of the application (used for tracking links, OAuth callbacks, etc.)
APP_URL=http://localhost:3000

# Timezone used for sending windows and display
# Must be a valid IANA timezone (e.g., America/New_York, Europe/London, Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# JWT Secret: sign login tokens. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Encryption Key: encrypts provider secrets in database. Must be a 32-byte base64 key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: if you change or lose this key, saved provider secrets can no longer be decrypted.
ENCRYPTION_KEY=

# ============================================================================
# SENDING CONFIGURATION
# ============================================================================
# DRY_RUN: if true, use FakeProvider instead of real sending (no actual emails sent)
# Default: true (safe - no real emails sent until explicitly enabled)
DRY_RUN=true

# SENDING_ENABLED: global kill switch for email sending
# Real sending requires: DRY_RUN=false AND SENDING_ENABLED=true
# Default: false (requires explicit opt-in)
SENDING_ENABLED=false

# MAILBOX_READING: read inbox's Sent Items and replies to hand-sent emails (read-only)
# Works in DRY_RUN mode. Requires Mail.Read application permission on Microsoft/Gmail.
# Default: true
MAILBOX_READING=true

# ============================================================================
# ADMIN USER CONFIGURATION
# ============================================================================
# Initial admin user created by `npm run seed` command
# Email: must be a valid email address
# Password: must be at least 8 characters
# Leave blank if you don't want to create/update admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================================================
# CLICK TRACKING CONFIGURATION
# ============================================================================
# TRACKING_BASE_URL: start of every tracking link
# - Local: http://localhost:3000
# - Production: https://tracking-domain.com (must be https)
TRACKING_BASE_URL=http://localhost:3000

# TRACKING_ALLOWED_HOSTS: comma-separated list of allowed redirect destinations
# Only these hosts can be linked to in click tracking (security feature)
TRACKING_ALLOWED_HOSTS=racko.ai,www.racko.ai

# TRACKING_FALLBACK_URL: where unknown links redirect (must be https and in TRACKING_ALLOWED_HOSTS)
TRACKING_FALLBACK_URL=https://racko.ai

# TRACKING_IP_SECRET: scrambles visitor IP addresses with HMAC (raw IPs never stored)
# Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave blank to disable IP tracking
TRACKING_IP_SECRET=

# TRUST_PROXY: set to true only if running behind Nginx/Cloudflare (reads IP from headers)
# Default: false
TRUST_PROXY=false
