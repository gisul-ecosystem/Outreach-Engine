{
  "name": "outreach-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others --names web,worker --prefix-colors blue,magenta \"npm:dev\" \"npm:worker\"",
    "worker": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check:dashboard": "tsx scripts/check-dashboard.ts",
    "email:test": "tsx scripts/test-email.ts",
    "mailbox:check": "tsx scripts/check-mailbox.ts",
    "sent:check": "tsx scripts/check-sent.ts",
    "tracking:rebuild": "tsx scripts/tracking-rebuild.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@next/env": "^16.4.2",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
